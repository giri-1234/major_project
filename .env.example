# Copy this file to .env and fill in your own credentials
# Never commit .env to GitHub

# Copernicus Data Space Ecosystem (CDSE) credentials
# Register free at: https://dataspace.copernicus.eu
CDSE_USERNAME=your_email@example.com
CDSE_PASSWORD=your_password

# Optional overrides (defaults work for most setups)
# OIL_SPILL_DEBUG=1
# OIL_SPILL_PORT=5000
# OIL_SPILL_LOG_LEVEL=INFO
# SNAP_GPT_PATH=D:\esa-snap\bin\gpt.exe
# SATELLITE_EXTRACT_DIR=C:\s1_extract
