# =============================================================================
# Git Ignore Configuration — Marine Oil Spill Monitoring System
# =============================================================================

# 1. Environment variables & Secrets — NEVER commit credentials
.env
*.env
*.pem
*.key

# 2. Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# 3. Virtual environments
venv/
.venv/
env/
ENV/

# 4. Machine Learning Models
# Ignore heavy checkpoints or pickle dumps, but track the production model
models/*.keras
models/*.pkl
!models/oil_spill_attention_model.h5
!models/.gitkeep

# 5. Satellite Data Directories (Large GeoTIFFs / Raw scenes)
datasets/sentinel1/incoming/*
!datasets/sentinel1/incoming/.gitkeep
datasets/sentinel1/processed/*
!datasets/sentinel1/processed/.gitkeep
datasets/sentinel1/processed_sar/*
!datasets/sentinel1/processed_sar/.gitkeep
datasets/mosdac/incoming/*
!datasets/mosdac/incoming/.gitkeep
datasets/mosdac/processed/*
!datasets/mosdac/processed/.gitkeep
datasets/mosdac/processed_sar/*
!datasets/mosdac/processed_sar/.gitkeep
*.tif
*.tiff

# 6. Satellite Downloads & Temporary Extraction
downloads/*
!downloads/.gitkeep
C:/s1_extract/

# 7. Runtime Uploads & Prediction Artifacts
static/uploads/*
!static/uploads/.gitkeep

# 8. Outputs, Logs & Prediction Reports
outputs/logs/*
!outputs/logs/.gitkeep
outputs/reports/*
!outputs/reports/.gitkeep

# 9. IDE, Editor & OS Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db
.kiro/

# 10. Scratch / Temp files
*.log
probe_result.txt
test_result.txt
carto_test.png
carto_text.txt
esri_dark.png
